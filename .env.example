# Server only: paste the complete JSON from the Firebase service-account file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Server only: Google Drive API key; falls back to the existing Firebase web key.
GOOGLE_DRIVE_API_KEY=
# Admin browser: Google OAuth Web application client ID, for Drive only.
GOOGLE_DRIVE_CLIENT_ID=
# Admin browser: public website origin, without a path.
MOVIES_PUBLIC_URL=http://127.0.0.1:5173

