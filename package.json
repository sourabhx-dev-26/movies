{
  "name": "movies-for-you",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/build-local.mjs && node --env-file-if-exists=.env scripts/preview.mjs",
    "build": "node --env-file-if-exists=.env scripts/build-local.mjs",
    "start": "node --env-file-if-exists=.env scripts/preview.mjs",
    "check": "node scripts/verify.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase": "^12.0.0",
    "jose": "^6.0.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
