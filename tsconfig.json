{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "vite/client",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "app/page.tsx",
    "app/admin/page.tsx",
    "app/api/**/*.ts",
    "components/brand.tsx",
    "components/movie-card.tsx",
    "components/browser-entry.tsx",
    "components/admin-entry.tsx",
    "lib/config.ts",
    "lib/types.ts",
    "lib/validation.ts",
    "lib/firebase-client.ts",
    "lib/server-auth.ts",
    "lib/database.ts",
    "lib/drive.ts",
    "db/schema.ts",
    "worker.ts",
    "cloudflare-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "examples"
  ]
}
